# Optional, non-secret. Copy to correlator.env. Environment variables of the same name override.
# Where run state lives (proposals, job, undo log, operator overrides). Default: ./state next to the code.
#CORRELATOR_STATE_DIR=/var/lib/face-correlator
# Command that reaches PostgreSQL; SQL is passed on stdin. Default: the local socket as the postgres OS user.
#CORRELATOR_PSQL=sudo -u postgres psql
#CORRELATOR_PSQL=ssh nvr sudo -u postgres psql
# Cluster ports on the NVR: Protect (unifi-protect, smart_detect_face) and the Access event log (ulp-go-syslog).
#PROTECT_DB_PORT=5433
#ACCESS_LOG_DB_PORT=5432
