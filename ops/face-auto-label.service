[Unit]
Description=Access/Protect face auto-labeller (badge correlation + embedding matcher)
After=network-online.target postgresql@14-main.service postgresql@14-protect.service unifi-protect.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/data/face-correlator
ExecStart=/usr/bin/python3 /data/face-correlator/face_auto_label.py --apply
UMask=0077
TimeoutStartSec=45min
